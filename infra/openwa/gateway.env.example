# A dedicated, single-session VOYA gateway. Supply credentials through host secrets.
NODE_ENV=production
PORT=2785
LOG_LEVEL=warn
ENGINE_TYPE=whatsapp-web.js
VOYA_AUTOMATION_OWNER=true
AUTO_START_SESSIONS=false
STATUS_SEED_ON_READY=false

DATABASE_TYPE=sqlite
DATABASE_NAME=./data/openwa.sqlite
MAIN_DATABASE_NAME=./data/main.sqlite
SESSION_DATA_PATH=./data/sessions
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media
REDIS_ENABLED=false
QUEUE_ENABLED=false
CACHE_ENABLED=false

# VOYA receives a signed media reference, then privately fetches the stored one-to-one image.
# Media MUST be archived to make /api/sessions/.../messages/.../media retrievable.
# Without archiving, OpenWA responds 404 and VOYA sends the event to dead_letter.
# Requires protected persistent storage, a defined retention/deletion policy, and operator approval
# before use with real customer content. Do not turn on unattended customer processing here.
MEDIA_DOWNLOAD_ENABLED=true
MEDIA_DOWNLOAD_MAX_BYTES=5242880
CHAT_MEDIA_ARCHIVE_ENABLED=true
WEBHOOK_MEDIA_INLINE_MAX_BYTES=0
WEBHOOK_MAX_PAYLOAD_BYTES=262144
WEBHOOK_CONTACT_DETAILS=false

# Required host secrets: API_MASTER_KEY, API_KEY_PEPPER.
# Set CORS_ORIGINS to the gateway dashboard's actual HTTPS origin.
# Set BASE_URL and DASHBOARD_URL to that origin when hosting.
# A paired production session requires an explicit persistence/retention decision.
