@@ -0,0 +1,82 @@
+import { isIndividualChat } from './individual-chat-gate';
+
+type Candidate = {
+  kind?: unknown;
+  chatId?: unknown;
+  isGroup?: unknown;
+  isStatusBroadcast?: unknown;
+};
+
+const cases = [
+  {
+    name: 'accepts an explicitly individual @c.us chat',
+    message: { kind: 'individual', chatId: '15550001111@c.us', isGroup: false },
+    expected: true,
+  },
+  {
+    name: 'accepts an explicitly individual @lid chat',
+    message: { kind: 'individual', chatId: '123456789012345@lid', isGroup: false },
+    expected: true,
+  },
+  {
+    name: 'rejects a group JID',
+    message: { kind: 'individual', chatId: '120363123456789@g.us', isGroup: false },
+    expected: false,
+  },
+  {
+    name: 'rejects a channel newsletter JID',
+    message: { kind: 'individual', chatId: '123456789@newsletter', isGroup: false },
+    expected: false,
+  },
+  {
+    name: 'rejects a status JID',
+    message: { kind: 'individual', chatId: 'status@broadcast', isGroup: false },
+    expected: false,
+  },
+  {
+    name: 'rejects a group classification on a user JID',
+    message: { kind: 'group', chatId: '15550001111@c.us', isGroup: false },
+    expected: false,
+  },
+  {
+    name: 'rejects a missing kind',
+    message: { chatId: '15550001111@c.us', isGroup: false },
+    expected: false,
+  },
+  {
+    name: 'rejects an unknown kind',
+    message: { kind: 'unknown', chatId: '15550001111@c.us', isGroup: false },
+    expected: false,
+  },
+  {
+    name: 'rejects an event marked as a group',
+    message: { kind: 'individual', chatId: '15550001111@c.us', isGroup: true },
+    expected: false,
+  },
+  {
+    name: 'rejects a missing group classification',
+    message: { kind: 'individual', chatId: '15550001111@c.us' },
+    expected: false,
+  },
+  {
+    name: 'rejects a missing chat JID',
+    message: { kind: 'individual', isGroup: false },
+    expected: false,
+  },
+  {
+    name: 'rejects an individual JID flagged as a status broadcast',
+    message: {
+      kind: 'individual',
+      chatId: '15550001111@c.us',
+      isGroup: false,
+      isStatusBroadcast: true,
+    },
+    expected: false,
+  },
+] satisfies Array<{ name: string; message: Candidate; expected: boolean }>;
+
+describe('isIndividualChat', () => {
+  it.each(cases)('$name', ({ message, expected }) => {
+    expect(isIndividualChat(message)).toBe(expected);
+  });
+});
diff --git a/src/modules/session/individual-chat-gate.ts b/src/modules/session/individual-chat-gate.ts
new file mode 100644
index 00000000..21e8cdb0
--- /dev/null
+++ b/src/modules/session/individual-chat-gate.ts
@@ -0,0 +1,14 @@
+export function isIndividualChat(message: {
+  kind?: unknown;
+  chatId?: unknown;
+  isGroup?: unknown;
+  isStatusBroadcast?: unknown;
+}): boolean {
+  return (
+    message.kind === 'individual' &&
+    message.isGroup === false &&
+    message.isStatusBroadcast !== true &&
+    typeof message.chatId === 'string' &&
+    /@(?:c\.us|lid)$/u.test(message.chatId)
+  );
+}
